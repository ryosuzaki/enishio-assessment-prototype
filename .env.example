# Enishio Assessment Engine - Environment Configuration
# PostgreSQL Database Connection (Neon / Supabase / Local PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/enishio_education?schema=public"

# Anthropic API Key。未設定だと AI同僚の応答と採点は実行されない（推測値で代替しない）
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
