# Enishio Assessment Engine - Environment Configuration

# PostgreSQL Database Connection (Local PostgreSQL / Neon / Supabase)
# ローカル実行例:
DATABASE_URL="postgresql://user:password@localhost:5432/enishio_education?schema=public"
# 公開デプロイ（Neon / Supabase サーバーレス接続プーリング推奨）例:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true&connection_limit=1"

# LLM API Key。未設定だと AI同僚の応答と採点は実行されない（推測値で代替しない）
OPENAI_API_KEY="your-openai-api-key-here"
# モデル選定設定。LLM_MODEL が全用途の既定値になり、用途別の変数はそれを上書きする。
# 採点機構はモデル非依存に設計してあり、性能とコストの兼ね合いで差し替えられる。
# LLM_MODEL="gpt-5.6-luna"
# EVALUATOR_MODEL="gpt-5.6-luna"
# MEDIATOR_MODEL="gpt-5.6-luna"
# DIALOGUE_MODEL="gpt-5.6-luna"

# 以下はマルチプロバイダ検証スクリプト（代行無効化チェック）でのみ使う。
# 本体の動作には不要。
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"
# GEMINI_MODEL="gemini-2.5-flash"

# デモ用: pending_human（評点保留・確信度不足）経路を実演するための閾値上書き（0〜1）。
# 未設定なら既定の 0.70 を使う。scoring_confidence 自体は変更しない——確定させるか
# どうかの運用パラメータだけを上げる。デモでこの経路を見せたいときのみ設定する。
# HITL_DEMO_CONFIDENCE_THRESHOLD="0.99"

