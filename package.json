{
  "name": "enishio-assessment-prototype",
  "version": "1.0.0",
  "description": "AI対話中の検証行動を抽出・採点するアセスメントエンジンの縦切りプロトタイプ",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "parse:anchors": "node scripts/import-anchors.cjs",
    "seed": "tsx scripts/seed-demo.ts",
    "seed:anchors": "tsx scripts/seed-anchors.ts",
    "lint": "eslint .",
    "check:no-leak": "node scripts/check-no-leaked-secrets.mjs",
    "check:ui": "node scripts/check-ui-tokens.mjs",
    "check:flaw-detection": "tsx scripts/check-flaw-detection-resistance.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test --project=chromium",
    "capture:screenshots": "playwright test --project=capture",
    "capture:video": "playwright test --project=video && bash scripts/build-demo-video.sh",
    "sim:equating": "tsx scripts/simulate-equating.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@google/genai": "^2.19.0",
    "@prisma/client": "^5.22.0",
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "openai": "^7.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.13.3",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.5.26",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
