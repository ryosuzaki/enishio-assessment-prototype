// Prisma schema for Enishio Education Assessment Engine
// Compliant with MVP Definition §4.1, 4.1.1, 4.4, 4.5 & T-17 Specification §5

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Learner {
  learner_id String    @id
  created_at DateTime  @default(now())
  sessions   Session[]
  ratings    Rating[]

  @@map("learners")
}

model Session {
  session_id  String    @id @default(uuid())
  learner_id  String
  session_seq Int
  started_at  DateTime  @default(now())
  ended_at    DateTime?

  learner               Learner                      @relation(fields: [learner_id], references: [learner_id], onDelete: Cascade)
  ratings               Rating[]
  anchor_responses      AnchorResponse[]
  prompt_turns          PromptTurn[]
  artifact_edit_series  ArtifactEditDistanceSeries[]
  injected_flaw_map     InjectedFlawMap[]

  @@index([learner_id, session_seq])
  @@map("sessions")
}

model Rating {
  rating_id            String    @id @default(uuid())
  session_id           String
  learner_id           String
  session_seq          Int
  step_id              String
  axis_id              String    // e.g. "axis_4"
  rating_category      Int       // 0..5
  rater_type           String    // "llm" | "human"
  rater_id             String
  scorer_model_version String    // "model_id/extract-v1/score-v1"
  stimulus_ref         String
  stimulus_type        String    // "generated" | "anchor"
  anchor_id            String?
  anchor_status        String?   // "pretest" | "operational" | "retired"
  stimulus_features    Json      // JSONB
  created_at           DateTime  @default(now())

  session        Session         @relation(fields: [session_id], references: [session_id], onDelete: Cascade)
  learner        Learner         @relation(fields: [learner_id], references: [learner_id], onDelete: Cascade)
  score_feedback ScoreFeedback[]

  @@index([session_id])
  @@index([learner_id])
  @@index([anchor_id])
  @@map("ratings")
}

model AnchorItem {
  anchor_id     String   @id
  family        String   // "A" | "B"
  anchor_status String   @default("pretest") // "pretest" | "operational" | "retired"
  content       Json     // full JSON structure: title, intro, proposal, q1, q2, confidence
  created_at    DateTime @default(now())

  responses AnchorResponse[]

  @@map("anchor_items")
}

model AnchorResponse {
  response_id    String   @id @default(uuid())
  session_id     String
  anchor_id      String
  q1_selection   String
  q2_selection   String
  confidence     Int      // 1..5
  q1_duration_ms Int
  q2_duration_ms Int
  created_at     DateTime @default(now())

  session     Session    @relation(fields: [session_id], references: [session_id], onDelete: Cascade)
  anchor_item AnchorItem @relation(fields: [anchor_id], references: [anchor_id], onDelete: Cascade)

  @@index([session_id])
  @@index([anchor_id])
  @@map("anchor_responses")
}

model PromptTurn {
  turn_id    String   @id @default(uuid())
  session_id String
  turn_seq   Int
  role       String   // "user" | "assistant" | "system"
  content    String   @db.Text
  timestamp  DateTime @default(now())

  session Session @relation(fields: [session_id], references: [session_id], onDelete: Cascade)

  @@index([session_id, turn_seq])
  @@map("prompt_turns")
}

model ArtifactEditDistanceSeries {
  id            String   @id @default(uuid())
  session_id    String
  timestamp     DateTime @default(now())
  edit_distance Int
  current_text  String?  @db.Text

  session Session @relation(fields: [session_id], references: [session_id], onDelete: Cascade)

  @@index([session_id, timestamp])
  @@map("artifact_edit_distance_series")
}

model InjectedFlawMap {
  id          String  @id @default(uuid())
  session_id  String
  flaw_id     String
  flaw_type   String  // "type_A" | "type_B" | "type_C"
  span_text   String  @db.Text
  is_flaw     Boolean @default(true) // false indicates verified intentional normal span [P-15]
  description String  @db.Text

  session Session @relation(fields: [session_id], references: [session_id], onDelete: Cascade)

  @@index([session_id])
  @@map("injected_flaw_map")
}

model ScoreFeedback {
  feedback_id            String   @id @default(uuid())
  rating_id              String
  actor_role             String   // "learner" | "evaluator"
  disagreement_direction String   // "too_low" | "too_high" | "unclear"
  free_text_reason       String   @db.Text // mandatory [P-12]
  cited_evidence_ref     String?
  scorer_model_version   String
  resolution             String?  @db.Text
  created_at             DateTime @default(now())

  rating Rating @relation(fields: [rating_id], references: [rating_id], onDelete: Cascade)

  @@index([rating_id])
  @@map("score_feedback")
}
